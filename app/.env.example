# Copy this file to .env.local (which is git-ignored) and fill in the two values from
# Supabase: Project Settings → API.
#   - Project URL
#   - anon / public key   (NOT the service_role key — that one must never be in the app)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
